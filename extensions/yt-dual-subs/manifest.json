{
  "manifest_version": 3,
  "name": "YT Dual Subs (Ollama)",
  "version": "0.1.0",
  "description": "Swedish YouTube captions + English translation from a local Ollama model.",
  "permissions": ["storage", "unlimitedStorage", "declarativeNetRequest"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["captions.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "YT Dual Subs" }
}
